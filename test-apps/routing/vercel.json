{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/old-blog/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/temporary",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/docs/v1/:path*",
      "destination": "/docs/:path*",
      "statusCode": 301
    },
    {
      "source": "/github",
      "destination": "https://github.com/vercel"
    },
    {
      "source": "/beta",
      "has": [
        {
          "type": "cookie",
          "key": "beta",
          "value": "1"
        }
      ],
      "destination": "/about?beta=1",
      "permanent": false
    },
    {
      "source": "/((?!docs/|app/|assets/).*)/edit",
      "destination": "/$1"
    },
    {
      "source": "/Case-Test",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/q-redirect",
      "destination": "/about?from=q",
      "permanent": false
    },
    {
      "source": "/has-header",
      "has": [
        {
          "type": "header",
          "key": "x-test",
          "value": "(?<v>yes|no)"
        }
      ],
      "destination": "/about?v=:v",
      "permanent": false
    },
    {
      "source": "/has-query",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(?<page>\\d+)"
        }
      ],
      "destination": "/docs/:page",
      "permanent": false
    },
    {
      "source": "/missing-cookie",
      "missing": [
        {
          "type": "cookie",
          "key": "session"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/status-303",
      "destination": "/about",
      "statusCode": 303
    },
    {
      "source": "/num/:id(\\d{1,3})",
      "destination": "/n/:id",
      "permanent": false
    },
    {
      "source": "/plus/:path+",
      "destination": "/p/:path+",
      "permanent": false
    },
    {
      "source": "/opt/:a?",
      "destination": "/o/:a?",
      "permanent": false
    },
    {
      "source": "/ops",
      "has": [
        {
          "type": "header",
          "key": "x-n",
          "value": {
            "gte": 10
          }
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/pre",
      "has": [
        {
          "type": "header",
          "key": "x-p",
          "value": {
            "pre": "ab"
          }
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "skip"
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/host-any",
      "has": [
        {
          "type": "host",
          "value": "(?<name>[^.]+)\\..*"
        }
      ],
      "destination": "/h/:name",
      "permanent": false
    },
    {
      "source": "/encoded/:x",
      "destination": "/e/:x",
      "permanent": false
    },
    {
      "source": "/qv",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "abc"
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/cv",
      "has": [
        {
          "type": "cookie",
          "key": "c",
          "value": "abc"
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/eqop",
      "has": [
        {
          "type": "header",
          "key": "x-e",
          "value": {
            "eq": "abc"
          }
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/incop",
      "has": [
        {
          "type": "header",
          "key": "x-i",
          "value": {
            "inc": [
              "abc",
              "def"
            ]
          }
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/neqop",
      "has": [
        {
          "type": "header",
          "key": "x-q",
          "value": {
            "neq": "abc"
          }
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/sufop",
      "has": [
        {
          "type": "header",
          "key": "x-s",
          "value": {
            "suf": "yz"
          }
        }
      ],
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/reop",
      "has": [
        {
          "type": "header",
          "key": "x-r",
          "value": {
            "re": "^a(?<rest>.*)$"
          }
        }
      ],
      "destination": "/r/:rest",
      "permanent": false
    },
    {
      "source": "/hash",
      "destination": "/about#top",
      "permanent": false
    },
    {
      "source": "/ext-q",
      "destination": "https://example.com/path?a=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog-post.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/example/:path*",
      "destination": "https://example.com/:path*"
    },
    {
      "source": "/gone",
      "destination": "/404.html",
      "statusCode": 410
    },
    {
      "source": "/r-query/:id",
      "destination": "/about.html?id=:id"
    },
    {
      "source": "/docs-alias/:path*",
      "destination": "/docs/:path*"
    },
    {
      "source": "/nowhere",
      "destination": "/does-not-exist.html"
    },
    {
      "source": "/echo/:path*",
      "destination": "https://httpbin.org/anything/:path*"
    },
    {
      "source": "/echo-q/:id",
      "destination": "https://httpbin.org/anything/q?id=:id&fixed=1"
    },
    {
      "source": "/rh",
      "destination": "https://httpbin.org/response-headers?X-Frame-Options=SAMEORIGIN&X-Debug=up"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-File",
          "value": ":file"
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "X-About",
          "value": "1"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "debug"
        }
      ],
      "headers": [
        {
          "key": "X-Debug",
          "value": "on"
        }
      ]
    },
    {
      "source": "/blog/:slug",
      "headers": [
        {
          "key": "X-Slug",
          "value": ":slug"
        }
      ]
    },
    {
      "source": "/assets/aasa",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/site.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-test"
        }
      ]
    }
  ]
}
